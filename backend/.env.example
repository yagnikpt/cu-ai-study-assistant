# Database
DATABASE_URL=postgresql+psycopg2://study_assistant:study_assistant@localhost:5433/study_assistant

# GCP (uses Application Default Credentials — run `gcloud auth application-default login`)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCS_BUCKET_NAME=
# Service account key JSON string (production only — set via fly secrets set).
# Leave empty for local dev to use ADC.
# GCP_SERVICE_ACCOUNT_JSON=

# Models
EMBEDDING_MODEL=gemini-embedding-001
GENERATION_MODEL=gemini-2.5-flash-lite
MULTIMODAL_EMBEDDING_MODEL=multimodalembedding@001

# Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# File uploads
MAX_UPLOAD_SIZE_MB=50

# Auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_SECRET=

# Environment (development | production)
ENVIRONMENT=development

# Static files directory (set in production Docker image)
# STATIC_DIR=/code/static
